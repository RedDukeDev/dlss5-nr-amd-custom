# NVIDIA's libraries (neural rendering, super resolution, ray reconstruction): too large for
# the repository, kept in third_party/ for building and packaging
third_party/nvngx_*.dll

# Build outputs
build/
runtime/build/
runtime/build-mingw/
linux/build/
out/
kernels/sr/
dist/
*.hsaco
*.isa
*.elf
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.dll
# DXVK, as released: shipped in the package (see dxvk/README.txt)
!dxvk/x64/*.dll
*.exe
*.cso
kernels/gfx12_emulated/
__pycache__/
*.pyc
*.log

# Anything derived from NVIDIA's network must never be committed: extracted
# PTX, captured launches (they hold weights), reference arrays, translation
# caches and the network itself.
*.ptx
*.fatbin
capture_*/
captures/
*.npz
*.npy
*.db
# The networks themselves are shipped in the release package only: a copy kept in
# third_party\ for packaging stays out of the repository.
nvngx_dlss*.dll

# Local tooling
.vs/
.vscode/
*.user

# Made at build time from the user's own copy of the library (kernels/tools/gen_enc0.py)
kernels/rr2_enc0_gen.inc
kernels/rr2_enc0.ptx
kernels/rr/kernels_rr_enc0.txt
